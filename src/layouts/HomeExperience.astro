---
import HomeHeader from '../components/home/HomeHeader.astro';
import HomeFooter from '../components/home/HomeFooter.astro';
import '../styles/home-experience.css';
import boldFont from '../assets/fonts/Rubik-Bold.woff2?url';
import regularFont from '../assets/fonts/Rubik-Regular.woff2?url';
import { homeContact, homeContactHref, homeContactLabel } from '../data/home-experience';
interface Props { title: string; description?: string; }
const { title, description = 'Do documento à carga. Encontre uma solução e prepare sua solicitação de orçamento para a TKS Entregas.' } = Astro.props;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
    <meta name="description" content={description}/><meta name="robots" content="noindex,nofollow"/>
    <meta name="theme-color" content="#011E3E"/><title>{title} | TKS Entregas</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml"/><link rel="icon" href="/favicon.ico" sizes="any"/>
    <link rel="apple-touch-icon" href="/icone_T_180.png"/><link rel="manifest" href="/site.webmanifest"/>
    <link rel="preload" href={boldFont} as="font" type="font/woff2" crossorigin/>
    <link rel="preload" href={regularFont} as="font" type="font/woff2" crossorigin/>
  </head>
  <body class="tks-home">
    <HomeHeader/><main id="conteudo" tabindex="-1"><slot/></main><HomeFooter/>
    <a class="h6-contact-float" data-home-contact href={homeContactHref} aria-label={homeContactLabel} target={homeContact ? '_blank' : undefined} rel={homeContact ? 'noopener noreferrer' : undefined}>
      {homeContact ? <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M20.5 3.5a11.9 11.9 0 0 0-18.7 14L.3 23.7l6.3-1.5A11.9 11.9 0 0 0 20.5 3.5ZM12 21.4a9.4 9.4 0 0 1-4.8-1.3l-.3-.2-3.7.9.9-3.6-.2-.4A9.5 9.5 0 1 1 12 21.4Zm5.2-7.1c-.3-.2-1.7-.8-1.9-.9-.3-.1-.5-.2-.7.2l-.9 1c-.2.2-.3.2-.6.1a7.8 7.8 0 0 1-3.9-3.4c-.3-.5.3-.5.9-1.6.1-.2 0-.4 0-.6l-.9-2.1c-.2-.5-.5-.5-.7-.5H7.9c-.2 0-.5.1-.7.3a2.9 2.9 0 0 0-.9 2.2c0 1.3 1 2.6 1.1 2.8.1.2 2 3 4.8 4.2 1.8.8 2.6.9 3.5.7.6-.1 1.7-.7 2-1.4.2-.7.2-1.3.1-1.4-.1-.1-.3-.2-.6-.4Z"/></svg> : <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M21 11.5a8.8 8.8 0 0 1-9 8.5 10 10 0 0 1-4-.8L3 21l1.3-4.2A8.1 8.1 0 0 1 3 11.5 8.8 8.8 0 0 1 12 3a8.8 8.8 0 0 1 9 8.5Z"/><path d="M7 11.5h10"/></svg>}
      <span>{homeContact ? 'WhatsApp da TKS' : 'Fale com a TKS'}</span>
    </a>
    <script>import '../scripts/home-experience';</script>
  </body>
</html>
