---
import Arrow from './Arrow.astro';
import { hasOfficialLogo, officialLogoPath } from '../data/brand';
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a class="brand" href="/" aria-label="TKS Entregas — início">
        {hasOfficialLogo ? <img src={officialLogoPath} width="200" height="70" alt="TKS Entregas" loading="lazy" decoding="async" /> : <span class="brand-fallback">TKS Entregas</span>}
      </a>
      <p class="footer-slogan">Do documento à carga.<br/>A TKS entrega.</p>
    </div>
    <nav class="footer-column" aria-label="Soluções no rodapé">
      <h2>Soluções</h2>
      <a href="/servicos">Todas as soluções</a>
      <a href="/frota">Frota</a>
      <a href="/para-empresas">Para empresas</a>
    </nav>
    <nav class="footer-column" aria-label="Empresa no rodapé">
      <h2>Empresa</h2>
      <a href="/sobre">Sobre a TKS</a>
      <a href="/blog">Conteúdos</a>
    </nav>
    <nav class="footer-column footer-contact" aria-label="Contato no rodapé">
      <h2>Contato</h2>
      <a href="/contato">Falar com a TKS <Arrow size={16}/></a>
      <a href="/orcamento">Solicitar orçamento <Arrow size={16}/></a>
    </nav>
  </div>
  <div class="container footer-bottom">
    <span>© {new Date().getFullYear()} TKS Entregas</span>
    <a href="/privacidade">Privacidade</a>
  </div>
</footer>
