---
import Arrow from './Arrow.astro';
import { brandAssets } from '../data/brand';
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a class="brand" href="/" aria-label="TKS Entregas — início">
        <picture>
          <source media="(max-width: 700px)" srcset={brandAssets.compact.white} width="310" height="110" />
          <img src={brandAssets.horizontal.white} width="613" height="110" alt="TKS Entregas" loading="lazy" decoding="async" />
        </picture>
      </a>
      <p class="footer-slogan">Do documento à carga.<br/>A TKS entrega.</p>
    </div>
    <nav class="footer-column" aria-label="Soluções no rodapé">
      <h2>Soluções</h2>
      <a href="/servicos">Todas as soluções</a>
      <a href="/frota">Frota</a>
      <a href="/para-empresas">Para empresas</a>
    </nav>
    <nav class="footer-column" aria-label="TKS no rodapé">
      <h2>TKS</h2>
      <a href="/sobre">Sobre a TKS</a>
      <a href="/blog">Conteúdos</a>
    </nav>
    <nav class="footer-column footer-contact" aria-label="Contato no rodapé">
      <h2>Contato</h2>
      <a href="/contato">Falar com a TKS <Arrow size={16} diagonal/></a>
      <a href="/orcamento">Solicitar orçamento <Arrow size={16} diagonal/></a>
    </nav>
  </div>
  <div class="container footer-bottom">
    <span>© {new Date().getFullYear()} TKS Entregas</span>
    <a href="/privacidade">Privacidade</a>
  </div>
</footer>
