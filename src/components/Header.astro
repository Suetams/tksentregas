---
import Arrow from './Arrow.astro';
import { brandAssets } from '../data/brand';
import '../styles/navigation.css';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isHome = path === '/';
const links = [
  ['/servicos', 'Soluções'],
  ['/frota', 'Frota'],
  ['/para-empresas', 'Para Empresas'],
  ['/sobre', 'Sobre'],
  ['/blog', 'Conteúdos'],
  ['/contato', 'Contato'],
];
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<a class="skip-link" href="#conteudo">Ir para o conteúdo</a>
<header class:list={['site-header', { 'is-home': isHome }]}>
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="TKS Entregas — início">
      <picture>
        <source media="(max-width: 700px)" srcset={brandAssets.compact.blue} width="310" height="110" />
        <img src={brandAssets.horizontal.blue} width="613" height="110" alt="TKS Entregas" decoding="async" />
      </picture>
    </a>
    <nav class="desktop-nav" aria-label="Navegação principal">
      {links.map(([href, label]) => <a href={href} aria-current={isActive(href) ? 'page' : undefined}>{label}</a>)}
    </nav>
    <a class="header-cta" href="/orcamento">Solicitar orçamento <Arrow size={19} diagonal/></a>
    <button class="menu-button" type="button" aria-label="Abrir menu" aria-expanded="false" aria-controls="mobile-menu">
      <span class="menu-lines" aria-hidden="true"><span></span><span></span></span>
    </button>
  </div>
  <nav id="mobile-menu" class="mobile-nav" aria-label="Navegação mobile" hidden>
    <div class="container mobile-nav-inner">
      {links.map(([href, label]) => <a href={href} aria-current={isActive(href) ? 'page' : undefined}>{label}<Arrow size={18}/></a>)}
      <a class="mobile-quote" href="/orcamento">Solicitar orçamento <Arrow size={22} diagonal/></a>
    </div>
  </nav>
</header>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const toggle = document.querySelector<HTMLButtonElement>('.menu-button');
  const menu = document.querySelector<HTMLElement>('#mobile-menu');
  const background = [...document.querySelectorAll<HTMLElement>('main, .site-footer')];
  let previousOverflow = '';
  let backgroundState: boolean[] = [];
  const desktop = window.matchMedia('(min-width: 1200px)');

  function closeMenu(returnFocus = false) {
    if (!toggle || !menu) return;
    const wasOpen = toggle.getAttribute('aria-expanded') === 'true';
    menu.hidden = true;
    toggle.setAttribute('aria-expanded', 'false');
    toggle.setAttribute('aria-label', 'Abrir menu');
    header?.classList.remove('is-menu-open');
    if (wasOpen) {
      document.body.style.overflow = previousOverflow;
      background.forEach((element, index) => { element.inert = backgroundState[index]; });
    }
    if (returnFocus) toggle.focus();
  }

  toggle?.addEventListener('click', () => {
    if (!toggle || !menu) return;
    if (toggle.getAttribute('aria-expanded') === 'true') {
      closeMenu();
      return;
    }
    menu.hidden = false;
    toggle.setAttribute('aria-expanded', 'true');
    toggle.setAttribute('aria-label', 'Fechar menu');
    header?.classList.add('is-menu-open');
    previousOverflow = document.body.style.overflow;
    backgroundState = background.map(element => element.inert);
    background.forEach(element => { element.inert = true; });
    document.body.style.overflow = 'hidden';
    menu.querySelector<HTMLAnchorElement>('a')?.focus();
  });

  document.addEventListener('keydown', event => {
    if (toggle?.getAttribute('aria-expanded') !== 'true') return;
    if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      closeMenu(true);
    }
    if (event.key === 'Tab' && header) {
      const controls = [...header.querySelectorAll<HTMLElement>('a[href], button:not(:disabled)')]
        .filter(element => element.getClientRects().length > 0);
      const first = controls[0];
      const last = controls[controls.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last?.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first?.focus();
      }
    }
  });
  menu?.addEventListener('click', event => {
    if ((event.target as HTMLElement).closest('a')) closeMenu();
  });
  document.addEventListener('click', event => {
    if (!(event.target as HTMLElement).closest('.site-header')) closeMenu();
  });
  header?.addEventListener('focusout', () => {
    requestAnimationFrame(() => {
      if (!header?.contains(document.activeElement)) closeMenu();
    });
  });
  desktop.addEventListener('change', event => {
    if (event.matches) {
      const focusWasInMenu = menu?.contains(document.activeElement);
      closeMenu();
      if (focusWasInMenu) header?.querySelector<HTMLAnchorElement>('.header-cta')?.focus();
    }
  });
  window.addEventListener('pagehide', () => closeMenu());

  // Keep the header's dimensions unchanged: scroll only changes its surface.
  let scrollFramePending = false;
  function updateHeader() {
    header?.classList.toggle('is-scrolled', window.scrollY > 20);
    scrollFramePending = false;
  }
  updateHeader();
  window.addEventListener('scroll', () => {
    if (scrollFramePending) return;
    scrollFramePending = true;
    requestAnimationFrame(updateHeader);
  }, { passive: true });
</script>
