---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import HomeFleet from '../components/HomeFleet.astro';
import { Image } from 'astro:assets';
import heroImage from '../assets/transport-hero.png';
import warehouseImage from '../assets/warehouse.png';
import { homeNeeds, homeContentReview } from '../data/home';
import '../styles/home.css';
---

<Layout title="Do documento à carga" home>
  <section class="home-hero" aria-labelledby="hero-title">
    <div class="home-hero-image" aria-hidden="true">
      <Image src={heroImage} widths={[960, 1440, 1942]} sizes="100vw" format="webp" quality={80} alt="" loading="eager" fetchpriority="high" />
    </div>
    <div class="container home-hero-inner">
      <div class="home-hero-copy">
        <span class="home-overline">TKS Entregas</span>
        <h1 id="hero-title"><span>Do documento à carga.</span><em>A TKS entrega.</em></h1>
        <p>Soluções de transporte para necessidades pontuais ou operações recorrentes.</p>
        <div class="home-hero-actions">
          <a class="button" href="/orcamento">Solicitar orçamento <Icon name="arrow" size={20} /></a>
          <a class="button home-button-ghost" href="/contato">Falar com a TKS <Icon name="arrow" size={20} /></a>
        </div>
        <ul class="home-hero-facts" aria-label="Sobre a TKS">
          <li>Desde {homeContentReview.companySince.value}</li>
          <li>Atendimento próximo</li>
          <li>Diferentes soluções</li>
        </ul>
      </div>
    </div>
    <p class="sr-only">Composição visual conceitual de transporte. Os veículos ilustrados não identificam a frota real da empresa.</p>
  </section>

  <section class="home-needs home-section" aria-labelledby="needs-title">
    <div class="container" data-reveal>
      <div class="home-section-heading">
        <span class="eyebrow">Seu ponto de partida</span>
        <h2 id="needs-title">O que você precisa transportar?</h2>
        <p>Conte sua necessidade. A TKS ajuda a encontrar a solução adequada.</p>
      </div>
      <div class="home-paths">
        {homeNeeds.map((need, index) => (
          <a class="home-path" href={`/orcamento?necessidade=${need.id}`} data-need-path={need.id}>
            <div class="home-path-top"><Icon name={need.icon} size={27} /><span>0{index + 1}</span></div>
            <h3>{need.title}</h3>
            <div class="home-path-bottom"><p>{need.text}</p><Icon name="arrow" size={21} /></div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <HomeFleet />

  <section class="home-business" aria-labelledby="business-title">
    <div class="home-business-image" aria-hidden="true">
      <Image src={warehouseImage} widths={[800, 1280, 1600]} sizes="(max-width: 700px) 100vw, 75vw" format="webp" quality={78} alt="" loading="lazy" decoding="async" />
    </div>
    <div class="container home-business-inner">
      <div class="home-business-copy" data-reveal>
        <span class="home-overline">Para empresas</span>
        <h2 id="business-title">Sua operação<br/>não precisa parar.</h2>
        <p>Soluções de transporte que acompanham as necessidades da rotina da sua empresa.</p>
        <ul class="home-business-topics" aria-label="Soluções empresariais">
          <li>Distribuição</li><li>Rotas programadas</li><li>E-commerce</li><li>Operações recorrentes</li>
        </ul>
        <a class="button home-button-ghost" href="/para-empresas">Conhecer soluções para empresas <Icon name="arrow" size={19} /></a>
      </div>
    </div>
    <p class="sr-only">Representação conceitual de uma operação logística, sem retratar instalações ou colaboradores reais da TKS.</p>
  </section>

  <section class="home-trust home-section" aria-labelledby="trust-title">
    <div class="container home-trust-inner" data-reveal>
      <div class="home-section-heading"><span class="eyebrow">Por que TKS</span><h2 id="trust-title">Transporte começa<br/>com confiança.</h2></div>
      <div class="home-trust-points">
        {[
          ['calendar', `Desde ${homeContentReview.companySince.value}`, 'Uma história construída no transporte.'],
          ['people', 'Atendimento próximo', 'Uma conversa para entender sua necessidade.'],
          ['route', 'Diferentes soluções', 'Do documento a volumes maiores.'],
          ['repeat', 'Pontual ou recorrente', 'Para pessoas e empresas.'],
        ].map(([icon, title, text]) => (
          <div class="home-trust-point"><Icon name={icon} size={24}/><div><h3>{title}</h3><p>{text}</p></div></div>
        ))}
      </div>
    </div>
  </section>

  <section class="home-closing" aria-labelledby="closing-title">
    <div class="container home-closing-inner" data-reveal>
      <div><span class="eyebrow">Vamos encontrar seu próximo caminho</span><h2 id="closing-title">Conte o que precisa transportar.</h2><p>A TKS ajuda a encontrar o caminho.</p></div>
      <a class="button" href="/orcamento">Solicitar orçamento <Icon name="arrow" size={20}/></a>
    </div>
  </section>
</Layout>

<script>
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  if (!reducedMotion.matches && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(entries => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        entry.target.classList.add('is-revealed');
        observer.unobserve(entry.target);
      }
    }, { threshold: 0.08 });
    for (const element of document.querySelectorAll<HTMLElement>('[data-reveal]')) {
      element.classList.add('reveal-ready');
      observer.observe(element);
    }
    reducedMotion.addEventListener('change', event => {
      if (event.matches) {
        observer.disconnect();
        document.querySelectorAll('.reveal-ready').forEach(element => element.classList.add('is-revealed'));
      }
    });
  }
</script>
