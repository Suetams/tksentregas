---
import Layout from '../layouts/Layout.astro';
import Arrow from '../components/Arrow.astro';
import HomeFleet from '../components/HomeFleet.astro';
import { Image, getImage } from 'astro:assets';
import { homeMedia, homePhotoCrops } from '../data/home-media';
import { homeNeeds, homeContentReview } from '../data/home';
import '../styles/home.css';
const heroMobile = homeMedia.heroMobile
  ? await getImage({ src: homeMedia.heroMobile, width: 960, format: 'webp', quality: 82 })
  : undefined;
const operationMobile = homeMedia.operationMobile
  ? await getImage({ src: homeMedia.operationMobile, width: 960, format: 'webp', quality: 80 })
  : undefined;
---

<Layout title="Do documento à carga" home>
  <section class="home-hero" aria-labelledby="hero-title" style={`--hero-photo-position: ${homePhotoCrops.hero.desktop}; --hero-photo-position-mobile: ${homePhotoCrops.hero.mobile};`}>
    <div class="container home-hero-inner">
      <p class="home-hero-origin">Desde {homeContentReview.companySince.value} <span>·</span> {homeContentReview.companyLocation.value}</p>
      <div class="home-hero-title">
        <h1 id="hero-title"><span>Do documento</span><span>à carga.</span><span class="home-hero-signature">A TKS entrega.</span></h1>
      </div>
      <div class="home-hero-copy">
        <p class="home-hero-description">Soluções de transporte para necessidades pontuais ou operações recorrentes.</p>
        <div class="home-hero-actions">
          <a class="button" href="/orcamento">Solicitar orçamento <Arrow diagonal size={20} /></a>
          <a class="home-link" href="/contato">Falar com a TKS <Arrow diagonal size={18} /></a>
        </div>
      </div>
    </div>
    <div class="home-hero-image" aria-hidden="true">
      <picture>
        {heroMobile && <source media="(max-width: 900px)" srcset={heroMobile.src} />}
        <Image src={homeMedia.hero} widths={[430, 640, 960, 1280, 1672]} sizes="(max-width: 900px) 100vw, 52vw" format="webp" quality={82} alt="" loading="eager" fetchpriority="high" />
      </picture>
    </div>
  </section>

  <section class="home-needs" aria-labelledby="needs-title">
    <div class="container home-needs-layout" data-reveal>
      <div class="home-needs-intro">
        <h2 id="needs-title">O que vai daqui<br/>até lá?</h2>
        <p>Conte sua necessidade. A TKS ajuda a encontrar a solução adequada.</p>
      </div>
      <div class="home-paths">
        {homeNeeds.map((need, index) => (
          <a class="home-path" href={'/orcamento?necessidade=' + need.id} data-need-path={need.id}>
            <span class="home-path-index" aria-hidden="true">0{index + 1}</span>
            <h3>{need.title}</h3>
            <span class="home-path-arrow"><Arrow diagonal size={24} /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <HomeFleet />

  <section class="home-business" aria-labelledby="business-title" style={`--operation-photo-position: ${homePhotoCrops.operation.desktop}; --operation-photo-position-mobile: ${homePhotoCrops.operation.mobile};`}>
    <div class="container home-business-layout">
      <div class="home-business-heading" data-reveal>
        <p class="home-label">Para empresas</p>
        <h2 id="business-title">Sua operação<br/>não precisa parar.</h2>
      </div>
      <div class="home-business-image" aria-hidden="true">
        <picture>
          {operationMobile && <source media="(max-width: 700px)" srcset={operationMobile.src} />}
          <Image src={homeMedia.operation} widths={[430, 640, 960, 1440]} sizes="(max-width: 700px) 100vw, 64vw" format="webp" quality={80} alt="" loading="lazy" decoding="async" />
        </picture>
      </div>
      <div class="home-business-copy" data-reveal>
        <p>Soluções de transporte que acompanham as necessidades da rotina da sua empresa.</p>
        <ul class="home-business-topics" aria-label="Soluções empresariais">
          <li>Distribuição</li><li>Rotas programadas</li><li>E-commerce</li><li>Operações recorrentes</li>
        </ul>
        <a class="home-link home-link-light" href="/para-empresas">Conhecer soluções para empresas <Arrow diagonal size={20} /></a>
      </div>
    </div>
  </section>

  <section class="home-history" aria-labelledby="history-title">
    <div class="container home-history-layout" data-reveal>
      <p class="home-history-year"><span class="home-label">Desde</span><span>{homeContentReview.companySince.value}</span></p>
      <div class="home-history-copy">
        <h2 id="history-title">É desde lá que a TKS<br/>está na estrada.</h2>
        <p>Soluções de transporte para pessoas e empresas.</p>
        <ul class="home-history-points">
          <li>Atendimento próximo</li><li>Diferentes soluções</li><li>Pontual ou recorrente</li>
        </ul>
      </div>
      {homeMedia.history && (
        <figure class="home-history-photo" style={`--history-photo-position: ${homeMedia.history.position ?? 'center'}; --history-photo-position-mobile: ${homeMedia.history.mobilePosition ?? homeMedia.history.position ?? 'center'};`}>
          <Image src={homeMedia.history.src} alt={homeMedia.history.alt} widths={[640, 960, 1440]} sizes="(max-width: 700px) calc(100vw - 48px), 90vw" format="webp" loading="lazy" decoding="async" />
        </figure>
      )}
    </div>
  </section>

  <section class="home-closing" aria-labelledby="closing-title">
    <div class="container home-closing-inner" data-reveal>
      <h2 id="closing-title">Tem algo para<br/>transportar?</h2>
      <a class="button home-closing-action" href="/orcamento">Solicitar orçamento <Arrow diagonal size={24}/></a>
    </div>
  </section>
</Layout>

<script>
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  if (!reducedMotion.matches && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(entries => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        entry.target.classList.add('is-revealed');
        observer.unobserve(entry.target);
      }
    }, { threshold: 0.06 });
    for (const element of document.querySelectorAll<HTMLElement>('[data-reveal]')) {
      element.classList.add('reveal-ready');
      observer.observe(element);
    }
    reducedMotion.addEventListener('change', event => {
      if (!event.matches) return;
      observer.disconnect();
      document.querySelectorAll('.reveal-ready').forEach(element => element.classList.add('is-revealed'));
    });
  }
</script>
