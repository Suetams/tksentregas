---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { Image } from 'astro:assets';
import heroImage from '../assets/transport-hero.png';
import warehouseImage from '../assets/warehouse.png';
import ServiceCards from '../components/ServiceCards.astro';
import Fleet from '../components/Fleet.astro';
import {needs} from '../data/site';
---
<Layout title="Do documento à carga">
<section class="hero"><div class="hero-photo" aria-hidden="true"><Image src={heroImage} width={1942} format="webp" quality={82} alt="" loading="eager" fetchpriority="high" /></div><div class="container hero-inner"><div class="hero-copy"><span class="eyebrow light">Uma solução para cada caminho</span><h1>Do documento<br/>à carga.<br/><em>A TKS entrega.</em></h1><p>Soluções de transporte para pessoas e empresas.<br class="desktop-break"/> Conte sua necessidade e encontre o próximo passo.</p><div class="hero-actions"><a class="button" href="/orcamento">Solicitar orçamento <Icon name="arrow" size={20}/></a><a class="button glass" href="/contato"><Icon name="people" size={19}/> Falar com a TKS</a></div><div class="hero-proofs"><span><Icon name="box"/><span>Da pequena entrega<small>à carga maior</small></span></span><span><Icon name="route"/><span>Para sua rotina<small>Pontual ou recorrente</small></span></span><span><Icon name="people"/><span>Atendimento<small>De pessoa para pessoa</small></span></span></div></div>
<span class="hero-image-note">Imagem gerada por IA · ilustrativa</span></div></section>
<section class="section needs-section"><div class="container"><div class="section-heading"><span class="eyebrow">Escolha sua necessidade</span><h2>O que você precisa transportar?</h2><p>Conte sua necessidade. Vamos ajudar você a encontrar a solução.</p></div><div class="need-grid">{needs.slice(0,6).map(need=><a href={`/orcamento?necessidade=${need.id}`} class="need-card"><Icon name={need.icon} size={34}/><h3>{need.title}</h3><p>{need.text}</p><Icon name="arrow" size={18}/></a>)}</div></div></section>
<section class="section solutions-section"><div class="container"><div class="section-heading heading-row"><div><span class="eyebrow">Nossas soluções</span><h2>Uma solução para cada entrega.</h2></div><a class="text-link" href="/servicos">Ver todas as soluções <Icon name="arrow" size={18}/></a></div><ServiceCards/></div></section>
<Fleet/>
<section class="business-section"><div class="business-photo" aria-hidden="true"><Image src={warehouseImage} width={1600} format="webp" quality={80} alt="" loading="lazy" decoding="async" /></div><div class="container business-layout"><div><span class="eyebrow light">Para empresas</span><h2>Sua operação<br/>não precisa parar.</h2><p>Da entrega pontual à distribuição recorrente, comece uma conversa sobre a rotina de transporte da sua empresa.</p><a class="button" href="/orcamento?necessidade=recorrente">Falar sobre minha operação <Icon name="arrow" size={18}/></a></div><div class="business-tiles">{[['route','Rotas programadas'],['box','Distribuição'],['van','E-commerce'],['people','Operações recorrentes']].map(([icon,title])=><a href="/para-empresas"><Icon name={icon} size={32}/><span>{title}</span></a>)}</div><div class="business-clearance" aria-hidden="true"></div></div><span class="business-image-note">Imagem gerada por IA · ilustrativa</span></section>
<section class="section process-section"><div class="container"><div class="section-heading"><span class="eyebrow">Um caminho simples</span><h2>Você conta. A gente entende.</h2></div><div class="process-grid">{[['01','file','Descreva a carga','Informe o que precisa transportar.'],['02','pin','Conte o trajeto','Origem, destino e prazo solicitado.'],['03','check','Revise os detalhes','Confira seu resumo antes de continuar.'],['04','people','Converse com o comercial','Condições e disponibilidade são confirmadas no atendimento.']].map(([number,icon,title,text])=><div class="process-item"><Icon name={icon} size={31}/><div><small>{number}</small><h3>{title}</h3><p>{text}</p></div></div>)}</div></div></section>
<section class="container quote-banner"><div><span class="eyebrow light">Seu próximo passo</span><h2>Vamos levar?</h2><p>Prepare seu orçamento em poucos passos.</p></div><form action="/orcamento" class="quick-quote"><label>O que deseja transportar?<select name="necessidade"><option value="orientacao">Selecione sua necessidade</option>{needs.slice(0,6).map(n=><option value={n.id}>{n.title}</option>)}</select></label><div class="quick-note"><Icon name="lock" size={18}/><span>Você revisa os dados antes<br/>de compartilhar.</span></div><button class="button" type="submit">Continuar orçamento <Icon name="arrow" size={19}/></button></form></section>
</Layout>
